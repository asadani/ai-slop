<meta name="description" content="AI slop is not text an AI wrote. It is work that shipped without judgment -- and the cost of that missing judgment does not disappear, it transfers to whoever reads, merges, or depends on the result.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,800;1,9..144,400;1,9..144,600&family=Spectral:ital,wght@0,400;0,500;0,600;1,400;1,600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#F4F2EB;
    --panel:#ECE9DF;
    --surface:#FBFAF5;
    --ink:#171C1A;
    --body:#363C39;
    --muted:#6B716C;
    --faint:#9A9E95;
    --line:#D9D5C8;
    --line-soft:#E6E2D6;
    --teal:#0F6E63;
    --teal-deep:#0A5147;
    --teal-wash:#E3EEEA;
    --clay:#B5563F;
    --clay-deep:#8F3E2B;
    --clay-wash:#F4E6DF;
    --gold:#9A7A2E;
    --gold-deep:#7A5F20;
    --gold-wash:#F1E9D4;
    --display:'Fraunces',Georgia,serif;
    --serif:'Spectral','Iowan Old Style',Georgia,serif;
    --mono:'IBM Plex Mono','SFMono-Regular',Menlo,monospace;
  }

  *{box-sizing:border-box;}
  html{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--body);
    font-family:var(--serif);
    font-size:18px;
    line-height:1.66;
    -webkit-font-smoothing:antialiased;
    /* The served Spectral SemiBold instance is missing the "ff" ligature glyph,
       so Chrome's print renderer synthesizes an unembeddable Type 3 bitmap for
       any word like "effort" set in bold. Disabling ligatures avoids the
       composite glyph entirely instead of relying on the font to supply it. */
    font-variant-ligatures: none;
  }

  .wrap{max-width:740px;margin:0 auto;padding:0 26px;}

  /* ---------- nav (fixed look, no theme toggle) ---------- */
  .nav{
    position:sticky;top:0;z-index:40;
    background:rgba(244,242,235,0.9);
    backdrop-filter:blur(7px);
    border-bottom:1px solid var(--line);
  }
  .nav-inner{
    max-width:740px;margin:0 auto;padding:0 26px;height:50px;
    display:flex;align-items:center;justify-content:space-between;
    font-family:var(--mono);font-size:12px;letter-spacing:0.02em;
  }
  .nav-brand{color:var(--ink);text-decoration:none;font-weight:600;}
  .nav-brand .d{color:var(--clay);}
  .nav-right{display:flex;gap:16px;align-items:center;}
  .nav-inner a.idx{color:var(--muted);text-decoration:none;}
  .nav-inner a.idx:hover{color:var(--teal);}
  .nav-tag{
    color:var(--muted);font-family:var(--mono);font-size:11px;
    letter-spacing:0.08em;text-transform:uppercase;
  }

  /* ---------- cover ---------- */
  .cover{padding:62px 0 30px;}
  .kicker{
    font-family:var(--mono);font-size:12px;letter-spacing:0.32em;
    text-transform:uppercase;color:var(--teal);font-weight:600;margin-bottom:26px;
  }
  h1.title{
    font-family:var(--display);
    font-weight:800;
    font-size:clamp(38px,7.8vw,64px);
    line-height:0.99;
    letter-spacing:-0.018em;
    color:var(--ink);
    margin:0 0 22px;
  }
  h1.title .amp{font-weight:400;font-style:italic;color:var(--clay);}
  .dek{
    font-family:var(--serif);font-size:clamp(19px,2.6vw,23px);
    line-height:1.44;color:var(--muted);font-style:italic;
    max-width:600px;margin:0 0 30px;
  }
  .memo{
    border-top:1px solid var(--line);border-bottom:1px solid var(--line);
    padding:16px 0;margin:0 0 34px;
    font-family:var(--mono);font-size:12.5px;line-height:1.9;color:var(--muted);
  }
  .memo b{color:var(--ink);font-weight:600;}
  .memo .lbl{display:inline-block;width:62px;color:var(--clay);}

  figure{margin:30px 0;text-align:center;}
  figure img{max-width:100%;height:auto;border-radius:6px;}
  figcaption{
    font-family:var(--mono);font-size:11.5px;line-height:1.6;color:var(--faint);
    margin-top:12px;letter-spacing:0.01em;
  }

  @media (min-width:840px){
    figure.wide{width:800px;max-width:94vw;margin-left:50%;transform:translateX(-50%);}
  }

  .cover-note{
    font-family:var(--serif);font-size:15.5px;color:var(--muted);
    border-left:3px solid var(--teal);padding:2px 0 2px 16px;margin-top:30px;
  }
  .cover-foot{
    margin-top:32px;padding-top:16px;border-top:1px solid var(--line);
    font-family:var(--mono);font-size:12px;letter-spacing:0.04em;color:var(--muted);
  }
  .cover-foot b{color:var(--ink);font-weight:600;}

  /* ---------- contents ---------- */
  .contents{padding:30px 0;border-top:1px solid var(--line);margin-top:24px;}
  .contents .clab{font-family:var(--mono);font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:var(--teal);margin-bottom:14px;}
  .contents ol{list-style:none;margin:0;padding:0;}
  .contents li{display:flex;align-items:baseline;gap:14px;padding:8px 0;border-bottom:1px solid var(--line-soft);}
  .contents .n{font-family:var(--mono);font-size:13px;color:var(--clay);width:34px;flex:none;font-weight:500;}
  .contents .t{color:var(--ink);font-weight:500;}
  .contents .t a{color:inherit;text-decoration:none;}
  .contents .t a:hover{color:var(--teal);}
  .contents .ds{color:var(--faint);font-size:14px;margin-left:auto;text-align:right;font-style:italic;}

  /* ---------- sections ---------- */
  .section{padding:54px 0 8px;}
  .section + .section{border-top:1px solid var(--line);}
  .sec-tag{
    font-family:var(--mono);font-size:12px;letter-spacing:0.06em;color:var(--teal);
    font-weight:600;margin-bottom:10px;
  }
  .sec-tag .num{color:var(--clay);}
  h2{
    font-family:var(--display);font-weight:600;
    font-size:clamp(27px,4.4vw,38px);line-height:1.08;letter-spacing:-0.012em;
    color:var(--ink);margin:0 0 22px;
  }
  h3{
    font-family:var(--display);font-weight:600;font-size:21px;line-height:1.2;
    color:var(--ink);margin:34px 0 8px;letter-spacing:-0.008em;
  }
  p{margin:0 0 18px;}
  p.lead{font-size:21px;line-height:1.5;color:var(--ink);font-family:var(--serif);}
  strong{font-weight:600;color:var(--ink);}
  em{font-style:italic;}
  a{color:var(--teal);text-decoration:none;border-bottom:1px solid var(--teal-wash);}

  .beat{
    font-family:var(--mono);font-size:11px;letter-spacing:0.2em;text-transform:uppercase;
    color:var(--clay);font-weight:600;margin:30px 0 8px;
  }

  /* ---------- pull quote ---------- */
  blockquote{
    margin:30px 0;padding:0 0 0 22px;border-left:3px solid var(--clay);
    font-family:var(--serif);font-weight:500;font-style:italic;
    font-size:22px;line-height:1.45;color:var(--ink);
  }
  .aphorism{
    text-align:center;font-family:var(--serif);font-style:italic;font-weight:500;
    font-size:19px;line-height:1.5;color:var(--teal-deep);margin:34px auto;max-width:40ch;
  }

  sup.c{font-family:var(--mono);font-size:9.5px;color:var(--clay);font-weight:600;vertical-align:super;line-height:0;padding-left:1px;}

  /* ---------- note / callout ---------- */
  .note{
    background:var(--teal-wash);border:1px solid #cfe2dc;border-left:3px solid var(--teal);
    border-radius:4px;padding:16px 20px;margin:26px 0;
  }
  .note.warn{background:var(--clay-wash);border-color:#e6cabd;border-left-color:var(--clay);}
  .note .nl{font-family:var(--mono);font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:var(--teal-deep);font-weight:600;margin-bottom:6px;}
  .note p{margin:0;font-size:16.5px;line-height:1.55;}

  /* ---------- table ---------- */
  .tbl-wrap{margin:28px 0;overflow-x:auto;border:1px solid var(--line);border-radius:4px;}
  table{width:100%;border-collapse:collapse;font-family:var(--serif);font-size:14.5px;}
  th{
    text-align:left;background:var(--ink);color:#F4F2EB;padding:11px 13px;
    font-family:var(--mono);font-size:10.5px;letter-spacing:0.04em;text-transform:uppercase;font-weight:500;
  }
  td{padding:12px 13px;border-bottom:1px solid var(--line-soft);vertical-align:top;line-height:1.5;}
  tr:last-child td{border-bottom:none;}
  tr:nth-child(even) td{background:var(--surface);}

  /* ---------- verdict ---------- */
  .verdict{
    background:var(--ink);color:#E9E6DC;border-radius:6px;padding:30px 30px 26px;margin:34px 0;
  }
  .verdict .vl{font-family:var(--mono);font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:var(--gold);margin-bottom:14px;}
  .verdict p{font-family:var(--serif);font-weight:500;font-style:italic;font-size:21px;line-height:1.5;color:#F4F2EB;margin:0;}
  .verdict p em{color:#E8A98E;font-style:italic;}

  /* ---------- checklist ---------- */
  .checklist{margin:24px 0;}
  .check{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid var(--line-soft);}
  .check .cn{font-family:var(--mono);font-size:13px;color:var(--teal);font-weight:600;flex:none;width:30px;}
  .check .ct{font-size:16px;line-height:1.5;}
  .check .ct b{display:block;color:var(--ink);font-family:var(--display);font-weight:600;font-size:17px;margin-bottom:2px;}

  /* ---------- references ---------- */
  .refs{padding:50px 0 10px;border-top:1px solid var(--line);}
  .refs ol{font-family:var(--mono);font-size:12.5px;line-height:1.6;color:var(--muted);padding-left:22px;}
  .refs li{margin-bottom:10px;}
  .refs a{word-break:break-word;}
  .small{font-size:13px;color:var(--faint);font-family:var(--mono);line-height:1.6;}

  /* ---------- audio ---------- */
  .aud{
    margin:34px 0;border:1px solid var(--line);border-radius:6px;background:var(--surface);
    overflow:hidden;
  }
  .aud-hd{display:flex;align-items:center;gap:14px;padding:14px 16px;border-bottom:1px solid var(--line);}
  .aud-ico{
    flex:none;width:40px;height:40px;border-radius:50%;background:var(--teal);color:#fff;
    display:flex;align-items:center;justify-content:center;font-size:13px;
  }
  .aud-hd b{display:block;font-family:var(--display);font-weight:600;font-size:15px;color:var(--ink);}
  .aud-sub{display:block;font-family:var(--mono);font-size:11.5px;color:var(--muted);margin-top:2px;}
  .aud audio{width:100%;display:block;background:var(--panel);}
  .aud-list{list-style:none;margin:0;padding:6px;max-height:15em;overflow:auto;border-top:1px solid var(--line);}
  .aud-list button{
    display:flex;gap:12px;align-items:baseline;width:100%;padding:8px 10px;border-radius:5px;
    font:inherit;font-size:13.5px;text-align:left;background:none;border:0;cursor:pointer;color:var(--body);
  }
  .aud-list button:hover{background:var(--panel);color:var(--ink);}
  .aud-list button[aria-current="true"]{background:var(--teal-wash);color:var(--teal-deep);font-weight:600;}
  .aud-n{flex:none;width:1.6em;font-family:var(--mono);font-size:11.5px;color:var(--faint);}
  .aud-nm{flex:1;min-width:0;}
  .aud-d{flex:none;font-family:var(--mono);font-size:11.5px;color:var(--faint);}

  /* ---------- footer ---------- */
  footer{
    border-top:1px solid var(--line);margin-top:40px;
    padding:22px 0 60px;
    display:flex;justify-content:space-between;align-items:center;
    font-family:var(--mono);font-size:12px;color:var(--faint);
  }
  footer a{color:var(--teal);text-decoration:none;}

  @media (max-width:560px){
    body{font-size:17px;}
    .contents .ds{display:none;}
  }

  @media print{
    .nav,footer,.aud{display:none!important;}
    body{background:#fff;font-size:11pt;line-height:1.62;}
    @page{ size:A4; margin:24mm 21mm 22mm 21mm; }
    @page :first{ margin:0; }
    .wrap{max-width:none;padding:0;}
    .cover{break-after:page;padding:24mm 21mm 22mm 21mm;}
    /* The page margin is 0 on the cover (see @page :first above) so the
       cover image can bleed to the physical edge; the padding just added
       to .cover keeps the surrounding text -- including the figcaption --
       at a normal inset. Only the <img> itself is pulled back out past
       that padding with a negative margin equal to it, so the picture
       reaches the page edge while its caption stays inset like the rest
       of the cover text. Square corners once it is edge-to-edge. */
    /* The source art is a 2:3 portrait (1024x1536) -- at full bleed WIDTH its
       natural height (315mm) is taller than the whole A4 page. Cap the height
       and crop with object-fit so the bleed is a wide band, not an overflow. */
    .cover figure img{margin:0 -21mm;width:calc(100% + 42mm);max-width:none;height:72mm;object-fit:cover;border-radius:0;}
    .cover figcaption{margin-top:6px;}
    .cover-note{margin-top:16px;}
    .cover-foot{margin-top:16px;padding-top:10px;}
    .section{padding:18px 0 6px;}
    h2,h3{break-after:avoid;break-inside:avoid;}
    .sec-tag{break-before:page;page-break-before:always;break-after:avoid;break-inside:avoid;}
    p.lead,.beat{break-after:avoid;break-inside:avoid;}
    p{orphans:3;widows:3;}
    li{orphans:2;widows:2;}
    figure,.tbl-wrap,.verdict,.note,blockquote,.check,.contents{break-inside:avoid;}
    a{color:var(--ink);border:none;}
  }
/* BOOK-FORGE:FONTS v1 sha=5448594fbf15 */
@font-face{font-family:"Fraunces";font-style:normal;font-weight:400;font-display:block;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Fraunces";font-style:normal;font-weight:600;font-display:block;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Fraunces";font-style:normal;font-weight:800;font-display:block;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Fraunces";font-style:italic;font-weight:400;font-display:block;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Fraunces";font-style:italic;font-weight:600;font-display:block;src:url(data:font/woff2;base64,) format("woff2")}
/* /BOOK-FORGE:FONTS */

/* BOOK-FORGE:MATTER-CSS v1 sha=c9624f4344d7 */
/* book-forge matter -- flow mode.
 *
 * Injected into essays that were never built as books. Each has its own
 * stylesheet, and they collide in specific, verified ways:
 *
 *   - they reuse `rule`, `lead`, `card`, `meta`, `small`, `cover`, `beat`,
 *     `kicker`, `num`, `refs` for their own purposes, and two of them define
 *     `preface` to mean a pull-quote. So every selector here is scoped under
 *     .bf-matter and nothing is styled by element alone at document scope.
 *
 *   - they define the SAME custom property names with different values, and
 *     idp-barbell has --crimson with no --accent at all. So the tokens below
 *     are declared on .bf-matter (never :root, which a host's later :root
 *     block would win) and each falls back through the names the hosts
 *     actually use before reaching a literal.
 *
 * Type is deliberately NOT set: font-family inherits from the host, so the
 * matter reads as part of the book it is bound into rather than as a graft.
 */

.bf-matter {
  --bf-ink:    var(--ink, #161A21);
  --bf-soft:   var(--ink-soft, var(--soft, #4E5665));
  --bf-faint:  var(--ink-faint, var(--faint, #7C8593));
  --bf-rule:   var(--rule, #D8DCE3);
  --bf-paper:  var(--paper, #FFFFFF);
  --bf-accent: var(--accent, var(--crimson, #9E2B3A));

  box-sizing: border-box;
  color: var(--bf-ink);
  text-align: left;
  font-style: normal;
}

.bf-matter *,
.bf-matter *::before,
.bf-matter *::after { box-sizing: border-box; }

/* Do NOT impose a width or padding by default. Every host already lays its
   own content out -- a bare `section` card at 820px in one, a `.wrap` at 740px
   in another -- and overriding that made the matter render at a different
   measure from the book it sits in, which reads as a different document.
   Set matter.measure in meta.yaml only for a host that constrains nothing. */
/* Deliberately declares NO max-width. `.bf-flow` outranks a host's bare
   `section { max-width: 820px }`, so declaring one here -- even
   `var(--bf-measure, none)` -- overrides the host and renders the matter at a
   different width from the book around it. Hosts that constrain nothing can
   opt in with matter.measure in meta.yaml, which appends a rule below. */
.bf-flow {
  margin-left: auto;
  margin-right: auto;
}
@media print {
  .bf-flow { break-before: page; page-break-before: always; padding-top: 0; }
}

.bf-matter h2 {
  margin: 0 0 6mm;
  padding: 0 0 3mm;
  border-bottom: 1px solid var(--bf-rule);
  font-size: 1.25rem;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: 0.01em;
  color: var(--bf-ink);
}

.bf-matter h3 {
  margin: 7mm 0 3mm;
  font-size: 1rem;
  font-weight: 600;
  color: var(--bf-ink);
}

.bf-matter p {
  margin: 0 0 3.5mm;
  font-size: 0.94rem;
  line-height: 1.6;
  color: var(--bf-soft);
}

.bf-matter b { font-weight: 600; color: var(--bf-ink); }
.bf-matter i { font-style: italic; }

.bf-matter .work {
  color: var(--bf-ink);
  font-size: 1rem;
}

.bf-matter .grant {
  margin: 5mm 0;
  padding: 4mm 5mm;
  border-left: 3px solid var(--bf-accent);
  background: var(--bf-paper);
}
.bf-matter .grant p:last-child { margin-bottom: 0; }

.bf-matter .signoff {
  margin-top: 5mm;
  color: var(--bf-faint);
}

.bf-matter .imprint {
  margin-top: 7mm;
  padding-top: 3mm;
  border-top: 1px solid var(--bf-rule);
  font-size: 0.8rem;
  color: var(--bf-faint);
}

/* --- about the author ------------------------------------------------- */

.bf-matter .bio p:last-child { margin-bottom: 0; }

.bf-matter .qrpanel {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6mm;
  margin: 8mm 0 0;
}
@media (max-width: 34rem) {
  .bf-matter .qrpanel { grid-template-columns: 1fr; }
}

.bf-matter .qrcard {
  display: flex;
  gap: 4mm;
  align-items: flex-start;
  padding: 4mm;
  border: 1px solid var(--bf-rule);
  break-inside: avoid;
  page-break-inside: avoid;
}

/* The host may style a bare .code; this is more specific, so it wins. */
.bf-matter .qrcard .code {
  flex: 0 0 auto;
  width: 24mm;
  background: none;
  padding: 0;
  border: 0;
}
.bf-matter .qrcard .code svg,
.bf-matter .qr { display: block; width: 24mm; height: 24mm; }

.bf-matter .qrcard .what {
  display: flex;
  flex-direction: column;
  gap: 1mm;
  min-width: 0;
}
.bf-matter .qrcard .what b { font-size: 0.9rem; }
.bf-matter .qrcard .what span {
  font-size: 0.82rem;
  line-height: 1.45;
  color: var(--bf-soft);
}
.bf-matter .qrcard .what code {
  /* Without this, <code> falls to the browser's default mono -- Consolas on
     Windows, DejaVu on Linux -- so the same book rendered a different face
     depending on the machine that built it. Books that happen to define their
     own .qrcard code rule were fine; the ones that did not, were not. */
  font-family: var(--mono, var(--bf-mono, ui-monospace, monospace));
  font-size: 0.78rem;
  color: var(--bf-accent);
  background: none;
  padding: 0;
}

.bf-matter .colophon {
  margin-top: 9mm;
  padding-top: 4mm;
  border-top: 1px solid var(--bf-rule);
  font-size: 0.8rem;
  line-height: 1.55;
  color: var(--bf-faint);
}
.bf-matter .colophon b { color: var(--bf-soft); }

/* --- screen reading order -------------------------------------------------
 *
 * On paper the order is right: cover, title page, copyright, the argument,
 * about. On a screen it is a wall -- a reader meets a full-bleed cover, a
 * title page, a copyright notice and an AI-disclosure note before one
 * sentence of the argument, which on a 30-page essay is four screens of
 * scrolling to find out whether it is worth reading.
 *
 * So screen only: drop the cover image, and send the copyright/disclosure
 * block to the end where a reader who wants it can still find it. @media
 * print is untouched, so the PDF keeps the print order exactly.
 *
 * body becomes a flex column because `order` needs a flex container. That
 * stops margins collapsing BETWEEN top-level sections -- which is why the
 * sections themselves are given a single margin direction below rather than
 * relying on collapse.
 */
@media screen {
  body {
    display: flex;
    flex-direction: column;
  }
  body > section.cover,
  body > section.sheet.cover { display: none; }

  body > section { order: 0; }
  body > .bf-front { order: 8; }
  body > .bf-about { order: 9; }
}
/* /BOOK-FORGE:MATTER-CSS */

</style>
</head>
